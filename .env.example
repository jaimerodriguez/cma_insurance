# Anthropic API credentials
# Copy this file to `.env` and fill in your real key (starts with "sk-ant-...").
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- MCP tool server (optional) --------------------------------------------
# Leave these unset and cma.py serves the domain tools inline as custom tools,
# exactly as before. Set BOTH to point the agents at mcp_server.py instead;
# MCP_TOOLS=0 forces the inline path back on without clearing them.
#
# Generate a token with:  python3 mcp_server.py --new-token
# The URL must be reachable from Anthropic's infrastructure, not just from you.
MCP_PUBLIC_URL=
MCP_BEARER_TOKEN=
# MCP_HOST=127.0.0.1
# MCP_PORT=8787
